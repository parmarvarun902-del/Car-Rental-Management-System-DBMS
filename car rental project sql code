CREATE DATABASE IF NOT EXISTS car_rental_db;
USE car_rental_db;

DROP TABLE IF EXISTS rentals;
DROP TABLE IF EXISTS cars;
DROP TABLE IF EXISTS customers;

CREATE TABLE customers (
    customer_id INT PRIMARY KEY AUTO_INCREMENT,
    full_name VARCHAR(100) NOT NULL,
    phone VARCHAR(15) NOT NULL UNIQUE,
    email VARCHAR(100) UNIQUE,
    driving_license VARCHAR(30) NOT NULL UNIQUE
);

CREATE TABLE cars (
    car_id INT PRIMARY KEY AUTO_INCREMENT,
    brand VARCHAR(50) NOT NULL,
    model VARCHAR(50) NOT NULL,
    registration_no VARCHAR(20) NOT NULL UNIQUE,
    daily_rate DECIMAL(10,2) NOT NULL CHECK (daily_rate > 0),
    availability_status ENUM('Available','Rented','Maintenance')
        NOT NULL DEFAULT 'Available'
);

CREATE TABLE rentals (
    rental_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    car_id INT NOT NULL,
    rental_date DATE NOT NULL,
    return_date DATE NOT NULL,
    actual_return_date DATE NULL,
    total_amount DECIMAL(10,2) NOT NULL DEFAULT 0,
    rental_status ENUM('Booked','Ongoing','Completed','Cancelled')
        NOT NULL DEFAULT 'Booked',
    CONSTRAINT fk_rental_customer FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id),
    CONSTRAINT fk_rental_car FOREIGN KEY (car_id)
        REFERENCES cars(car_id),
    CONSTRAINT chk_rental_dates CHECK (return_date >= rental_date)
);

