-- QUERY 1: Display all cars
SELECT car_id, brand, model, registration_no, daily_rate, availability_status
FROM cars ORDER BY car_id;

-- QUERY 2: List cars currently available for rent
SELECT brand, model, daily_rate
FROM cars
WHERE availability_status = 'Available';

-- QUERY 3: Show rentals with customer and car details
SELECT r.rental_id, c.full_name,
       CONCAT(ca.brand, ' ', ca.model) AS car,
       r.rental_date, r.return_date, r.total_amount, r.rental_status
FROM rentals r
JOIN customers c ON r.customer_id = c.customer_id
JOIN cars ca ON r.car_id = ca.car_id
ORDER BY r.rental_id;

-- QUERY 4: Total rental amount by customer
SELECT c.full_name, SUM(r.total_amount) AS total_rental_amount
FROM customers c
JOIN rentals r ON c.customer_id = r.customer_id
GROUP BY c.customer_id, c.full_name
ORDER BY total_rental_amount DESC;

-- QUERY 5: Count rentals by status
SELECT rental_status, COUNT(*) AS number_of_rentals
FROM rentals
GROUP BY rental_status;

-- QUERY 6: Find rentals whose amount is above the average rental amount
SELECT rental_id, total_amount, rental_status
FROM rentals
WHERE total_amount > (SELECT AVG(total_amount) FROM rentals);

-- QUERY 7: Find cars that have never been rented
SELECT ca.car_id, ca.brand, ca.model
FROM cars ca
WHERE NOT EXISTS (
    SELECT 1 FROM rentals r WHERE r.car_id = ca.car_id
);

